<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TorVpnForWindows.Tests</RootNamespace>
    <AssemblyName>TunnelSmokeTest</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AppDir>$(MSBuildProjectDirectory)\..\..\src\TorVpnForWindows</AppDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The engine is compiled straight from the application sources rather than referenced as a
      library, so this exercises exactly the code that ships. Only Core and Config are pulled in;
      the WPF layer is not involved.
    -->
    <Compile Include="$(AppDir)\Core\*.cs" />
    <Compile Include="$(AppDir)\Config\*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\tools\Payload.targets" />

</Project>
