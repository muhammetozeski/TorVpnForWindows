<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TorVpnForWindows.Tests</RootNamespace>
    <AssemblyName>FirewallTest</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AppDir>$(MSBuildProjectDirectory)\..\..\src\TorVpnForWindows</AppDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The filter code as it ships, compiled from the application sources. -->
    <Compile Include="$(AppDir)\Core\*.cs" />
    <Compile Include="$(AppDir)\Config\*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
