<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TorVpnForWindows.Tests</RootNamespace>
    <AssemblyName>PathResolutionTest</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <AppDir>$(MSBuildProjectDirectory)\..\..\src\TorVpnForWindows</AppDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The resolver under test, compiled from the application sources. -->
    <Compile Include="$(AppDir)\Core\BinaryResolver.cs" />
    <Compile Include="$(AppDir)\Core\Log.cs" />
    <Compile Include="$(AppDir)\Core\AppPaths.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
