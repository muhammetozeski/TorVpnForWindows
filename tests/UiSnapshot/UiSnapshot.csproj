<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TorVpnForWindows.Tests</RootNamespace>
    <AssemblyName>UiSnapshot</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>TorVpnForWindows.Tests.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Referenced rather than compiled in, so the controls are exactly the ones that ship. The App
      class is never created: its OnStartup would run as soon as the dispatcher does. The styles come
      from App.xaml, embedded here and parsed on its own.
    -->
    <ProjectReference Include="..\..\src\TorVpnForWindows\TorVpnForWindows.csproj" />
    <EmbeddedResource Include="..\..\src\TorVpnForWindows\App.xaml" LogicalName="UiSnapshot.App.xaml" />
  </ItemGroup>

</Project>
