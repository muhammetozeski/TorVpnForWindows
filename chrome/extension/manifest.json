{
  "manifest_version": 3,
  "name": "TorVPN",
  "version": "0.1.0",
  "description": "Browse through a Tor client running inside this extension. No native helper required.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["proxy", "privacy", "storage", "debugger", "offscreen", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "TorVPN", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'" }
}
