<Window x:Class="TorVpnForWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tor VPN for Windows"
        Height="700" Width="470"
        MinHeight="620" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9"
                        Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center">
                    <Path Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 12,6 L 12,12 L 16,14"
                          Stroke="White" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="19" Height="19"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="Tor VPN for Windows"
                               FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource Muted}"
                               Text="All traffic through Tor" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="Tabs" Grid.Row="1" Grid.RowSpan="2" Margin="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="10,0,0,0">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ============================ STATUS ============================ -->
            <TabItem x:Name="TabStatus" Header="Status">
                <!-- Scrollable: with the map and the traffic cards shown, the content is taller
                     than the window's minimum height. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20,14,20,18" MaxWidth="520" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Power button -->
                    <ToggleButton x:Name="PowerToggle" Grid.Row="0"
                                  Style="{StaticResource PowerButton}"
                                  HorizontalAlignment="Center"
                                  Margin="0,6,0,0"
                                  Click="OnPowerToggleClick" />

                    <!-- State -->
                    <StackPanel Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="StateText" Text="Not connected"
                                   FontSize="19" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="StateHint" Style="{StaticResource Muted}"
                                   Text="Your traffic is going out normally."
                                   TextAlignment="Center" MaxWidth="330" Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- Bootstrap progress -->
                    <StackPanel x:Name="ProgressPanel" Grid.Row="2" Margin="0,16,0,0"
                                Visibility="Collapsed">
                        <ProgressBar x:Name="BootstrapBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="BootstrapText" Style="{StaticResource Muted}"
                                   TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>

                    <!-- Exit details -->
                    <Border x:Name="ExitCard" Grid.Row="3" Style="{StaticResource Card}"
                            Margin="0,18,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ExitAddressLabel" Grid.Column="0"
                                           Style="{StaticResource Muted}" Text="Exit address" />
                                <TextBlock x:Name="ExitAddressValue" Grid.Column="1"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           FontFamily="{StaticResource MonoFont}" Text="—" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ExitCountryLabel" Grid.Column="0"
                                           Style="{StaticResource Muted}" Text="Exit country" />
                                <TextBlock x:Name="ExitCountryValue" Grid.Column="1"
                                           HorizontalAlignment="Right" Text="—" />
                            </Grid>
                            <TextBlock x:Name="ExitConfirmText" Style="{StaticResource Muted}"
                                       Margin="0,10,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Exit country on the world map -->
                    <Border x:Name="MapCard" Grid.Row="4" Style="{StaticResource Card}"
                            Padding="0" Margin="0,10,0,0" Visibility="Collapsed"
                            ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <Viewbox Stretch="Uniform" StretchDirection="Both">
                                <!-- 720 x 300 is the equirectangular box the outlines were
                                     projected into, minus the empty Antarctic band. -->
                                <Canvas x:Name="MapCanvas" Width="720" Height="300" ClipToBounds="True">
                                    <Path x:Name="MapLand"
                                          Canvas.Left="0" Canvas.Top="-12"
                                          Fill="#FF2B3141"
                                          Stroke="#FF3A4256"
                                          StrokeThickness="0.6" />
                                    <Ellipse x:Name="MapHalo"
                                             Width="34" Height="34"
                                             Fill="{StaticResource SuccessBrush}"
                                             Opacity="0.22"
                                             Visibility="Collapsed" />
                                    <Ellipse x:Name="MapMarker"
                                             Width="12" Height="12"
                                             Fill="{StaticResource SuccessBrush}"
                                             Stroke="White"
                                             StrokeThickness="2"
                                             Visibility="Collapsed" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="MapUnknownText"
                                       Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,8" FontSize="11"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Traffic -->
                    <Grid x:Name="TrafficPanel" Grid.Row="5" VerticalAlignment="Top"
                          Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2193;" Foreground="{StaticResource SuccessBrush}"
                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DownloadLabel" Style="{StaticResource Muted}"
                                               Text="Download" FontSize="11" Margin="5,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="DownloadSpeed" Text="0 B/s" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                                <TextBlock x:Name="DownloadTotal" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2191;" Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="UploadLabel" Style="{StaticResource Muted}"
                                               Text="Upload" FontSize="11" Margin="5,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="UploadSpeed" Text="0 B/s" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                                <TextBlock x:Name="UploadTotal" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Footer actions -->
                    <StackPanel Grid.Row="6" Margin="0,14,0,0">
                        <TextBlock x:Name="UdpNotice" Style="{StaticResource Muted}"
                                   FontSize="11" TextAlignment="Center" Margin="0,0,0,10"
                                   Visibility="Collapsed" />
                        <Button x:Name="NewIdentityButton" Content="New circuit"
                                HorizontalAlignment="Center" IsEnabled="False"
                                Click="OnNewIdentityClick" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ SETTINGS ============================ -->
            <TabItem x:Name="TabSettings" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,20">
                    <!-- Capped so the labels and their controls stay together when the window is
                         widened; without it the pickers drift to the far right edge. -->
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">

                        <TextBlock x:Name="SectionConnection" Style="{StaticResource SectionHeader}"
                                   Text="CONNECTION" Margin="0,14,0,8" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" Grid.Column="0" Text="Language"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="170"
                                      SelectionChanged="OnLanguageChanged" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExitCountryLabelSetting" Grid.Column="0"
                                       Text="Exit country" VerticalAlignment="Center" />
                            <ComboBox x:Name="ExitCountryCombo" Grid.Column="1" Width="170"
                                      SelectionChanged="OnExitCountryChanged" />
                        </Grid>
                        <TextBlock x:Name="ExitCountryHint" Style="{StaticResource Muted}"
                                   Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BridgeLabel" Grid.Column="0" Text="Bridges"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="BridgeCombo" Grid.Column="1" Width="170"
                                      SelectionChanged="OnBridgeModeChanged" />
                        </Grid>
                        <TextBlock x:Name="BridgeHint" Style="{StaticResource Muted}" />

                        <StackPanel x:Name="CustomBridgePanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="CustomBridgeHint" Style="{StaticResource Muted}"
                                       Margin="0,0,0,6" />
                            <TextBox x:Name="CustomBridgeBox"
                                     Height="92"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11"
                                     LostFocus="OnCustomBridgesLostFocus" />
                        </StackPanel>

                        <TextBlock x:Name="SectionNetwork" Style="{StaticResource SectionHeader}"
                                   Text="NETWORK" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="KillSwitchLabel" Text="Kill switch" />
                                <TextBlock x:Name="KillSwitchHint" Style="{StaticResource Muted}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="KillSwitchToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" Click="OnSettingToggled" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="StrictRouteLabel" Text="Strict routing" />
                                <TextBlock x:Name="StrictRouteHint" Style="{StaticResource Muted}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="StrictRouteToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" Click="OnSettingToggled" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="AllowLanLabel" Text="Allow local network" />
                                <TextBlock x:Name="AllowLanHint" Style="{StaticResource Muted}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="AllowLanToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" Click="OnSettingToggled" />
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ExclusionsLabel" Text="Excluded applications"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ExclusionsHint" Style="{StaticResource Muted}"
                                           Margin="0,4,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ExclusionsCount" Grid.Column="0"
                                               Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="OpenExclusionsButton" Grid.Column="1"
                                            Content="Open the list" Click="OnOpenExclusionsClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SectionApplication" Style="{StaticResource SectionHeader}"
                                   Text="APPLICATION" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutoConnectLabel" Grid.Column="0"
                                       Text="Connect on start" VerticalAlignment="Center" />
                            <CheckBox x:Name="AutoConnectToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" Click="OnSettingToggled" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MinimizeToTrayLabel" Grid.Column="0"
                                       Text="Close to the notification area" VerticalAlignment="Center" />
                            <CheckBox x:Name="MinimizeToTrayToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" Click="OnSettingToggled" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartMinimizedLabel" Grid.Column="0"
                                       Text="Start minimised" VerticalAlignment="Center" />
                            <CheckBox x:Name="StartMinimizedToggle" Grid.Column="1"
                                      Style="{StaticResource Switch}" Click="OnSettingToggled" />
                        </Grid>

                        <TextBlock x:Name="SectionAdvanced" Style="{StaticResource SectionHeader}"
                                   Text="ADVANCED" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TunNameLabel" Grid.Column="0" Text="Adapter name"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="TunNameBox" Grid.Column="1" Width="170"
                                     LostFocus="OnAdvancedLostFocus" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MtuLabel" Grid.Column="0" Text="MTU"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="MtuBox" Grid.Column="1" Width="170"
                                     LostFocus="OnAdvancedLostFocus" />
                        </Grid>

                        <TextBlock x:Name="RestartNeededText" Style="{StaticResource Muted}"
                                   Margin="0,8,0,0" FontSize="11" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ LOG ============================ -->
            <TabItem x:Name="TabLog" Header="Log">
                <Grid Margin="14,12,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF101319"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ListBox x:Name="LogList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,1" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5"
                                               Foreground="{Binding Source, Converter={StaticResource LogSourceToBrush}}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="LogCopyButton" Content="Copy" Click="OnLogCopyClick" />
                        <Button x:Name="LogClearButton" Content="Clear" Margin="8,0,0,0"
                                Click="OnLogClearClick" />
                        <Button x:Name="LogFolderButton" Content="Open folder" Margin="8,0,0,0"
                                Click="OnLogFolderClick" />
                        <CheckBox x:Name="AutoScrollToggle" Style="{StaticResource Switch}"
                                  IsChecked="True" Margin="14,0,0,0" />
                        <TextBlock x:Name="AutoScrollLabel" Style="{StaticResource Muted}"
                                   Text="Auto scroll" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
