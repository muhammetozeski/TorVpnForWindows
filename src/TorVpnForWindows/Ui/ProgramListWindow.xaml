<Window x:Class="TorVpnForWindows.Ui.ProgramListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programs"
        Width="640" Height="640"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Rows are not selectable: every action is a button on the row itself. -->
        <Style TargetType="ListBoxItem" x:Key="ProgramRow">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF232733" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProgramRowTemplate">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="24" Height="24" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarningBrush}"
                               FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding NoteVisibility}" />
                </StackPanel>

                <Button Grid.Column="2" VerticalAlignment="Center" MinWidth="72"
                        Content="{Binding ActionText}"
                        IsEnabled="{Binding ActionEnabled}"
                        Click="OnRowActionClick" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.25*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="15.5" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <TextBlock x:Name="DescriptionText" Style="{StaticResource Muted}" />
            <TextBlock x:Name="MatchNoteText" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Programs on the list -->
        <Grid Grid.Row="2" Margin="0,16,0,8">
            <TextBlock x:Name="ListedHeader" Style="{StaticResource SectionHeader}" Margin="0"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ListedCount" Style="{StaticResource Muted}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ListBox x:Name="ListedBox"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ProgramRow}"
                         ItemTemplate="{StaticResource ProgramRowTemplate}" />
                <TextBlock x:Name="ListedEmpty" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" MaxWidth="380" />
            </Grid>
        </Border>

        <!-- Running programs -->
        <Grid Grid.Row="4" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RunningHeader" Grid.Column="0" Style="{StaticResource SectionHeader}"
                       Margin="0" VerticalAlignment="Center" />
            <TextBlock x:Name="SearchLabel" Grid.Column="1" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Grid.Column="2" Width="180" VerticalAlignment="Center"
                     TextChanged="OnSearchChanged" />
            <Button x:Name="RefreshButton" Grid.Column="3" Margin="8,0,0,0" Click="OnRefreshClick" />
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ListBox x:Name="RunningBox"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         ItemContainerStyle="{StaticResource ProgramRow}"
                         ItemTemplate="{StaticResource ProgramRowTemplate}" />
                <TextBlock x:Name="RunningEmpty" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Button x:Name="BrowseButton" HorizontalAlignment="Left" Click="OnBrowseClick" />
            <Button x:Name="CloseButton" HorizontalAlignment="Right" MinWidth="90" IsCancel="True"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
